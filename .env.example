# --- WordPress ---
WP_URL=https://www.example-church.org
WP_USER=
WP_PASSWORD=
WP_POST_TYPE=podcasts
# Category ticked on every sermon in addition to its series
WP_ALWAYS_CATEGORY=All Sermons
# New posts are created with this status from the UI default (draft|publish)
WP_DEFAULT_STATUS=draft

# --- AI models ---
# auto = large-v3-turbo on GPU, small.en on CPU
WHISPER_MODEL=auto
# Local LLM (via the ollama container) used to find the sermon boundaries and suggest a title.
# Blank disables it and falls back to the speech-rate heuristic.
LLM_MODEL=qwen2.5:7b-instruct

# --- Audio ---
MP3_BITRATE=64k
FILE_PREFIX=Sermon_

# --- Host folders mounted into the container (read-only) ---
NAS_PATH=/mnt/nas
LOCAL_PATH=/srv/recordings

# --- File browser roots (Name=container path) ---
BROWSE_ROOTS=NAS=/media/nas,Local=/media/local,Uploads=/data/uploads
START_PATH=NAS
# Where recordings + finished MP3s are archived; the app suggests <ARCHIVE_ROOT>/YYYY/MM - Month/YYYY_MM_DD
ARCHIVE_ROOT=NAS
